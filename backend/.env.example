# Server Environment Configuration
PORT=3001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT & Authentication Secret Keys
JWT_SECRET=apexlearn_super_secure_jwt_secret_key_2026_dev
JWT_EXPIRES_IN=7d
COOKIE_SECRET=apexlearn_cookie_secret_key_2026_dev

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apexlearn_db?schema=public

# AWS S3 Storage (Phase 10)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_S3_BUCKET=apexlearn-course-assets

# Razorpay Credentials (Phase 12)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key

# SMTP Email Configuration (Phase 11)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user
SMTP_PASS=mock_smtp_pass
SMTP_FROM="ApexLearn Support <no-reply@apexlearn.edu>"
