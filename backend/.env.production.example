# ==============================================================================
# Aivortex / ApexLearn - Backend Production Environment Configuration (AWS)
# ==============================================================================
# Target EC2 Host: 13.201.19.85 (ap-south-1)
# Target S3 Bucket: aivortex (ap-south-1)
# Target RDS: aivortex (PostgreSQL, ap-south-1)
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production

# Client Domain / IP (Allowed Origins for CORS)
# Update this with your custom domain or leave your EC2 IP
CLIENT_URL=http://13.201.19.85

# Security & Authentication Secrets
# (Generate a 64-char crypto string using: openssl rand -hex 32)
JWT_SECRET=replace_with_64_char_crypto_random_jwt_secret_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_64_char_crypto_random_cookie_secret_in_production

# Amazon RDS PostgreSQL Database Connection
# Once RDS status changes from 'Creating' to 'Available', replace YOUR_RDS_ENDPOINT
# Note: '#' in password is URL-encoded as '%23' for PostgreSQL URI compatibility
DATABASE_URL="postgresql://postgres:jaison1515%40@YOUR_RDS_ENDPOINT:5432/aivortex_db?schema=public&sslmode=require"

# AWS S3 Storage Configuration
AWS_REGION=ap-south-1
AWS_S3_BUCKET=aivortex
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Optional Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_YourKeyId
RAZORPAY_KEY_SECRET=YourRazorpaySecret
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretKey

# Optional Transactional Email (Amazon SES or SMTP)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=YOUR_SES_OR_SMTP_USER
SMTP_PASS=YOUR_SES_OR_SMTP_PASS
SMTP_FROM="Aivortex LMS <no-reply@aivortex.com>"
