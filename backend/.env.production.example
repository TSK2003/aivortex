# ========================================================
# ApexLearn Backend Production Environment (AWS Template)
# Configure these variables in AWS Systems Manager / .env
# ========================================================

# Server Configuration
PORT=3001
NODE_ENV=production

# Client Domain (CloudFront or Custom Domain with HTTPS)
CLIENT_URL=https://learn.yourdomain.com

# Cryptographic Authentication Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=replace_with_64_char_crypto_random_jwt_secret_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_64_char_crypto_random_cookie_secret_in_production

# Amazon RDS PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[rds-endpoint]:5432/[dbname]?schema=public&sslmode=require
DATABASE_URL="postgresql://apexadmin:YourStrongRdsPassword@apexlearn-db.cxxxxxxxx.ap-south-1.rds.amazonaws.com:5432/apexlearn_prod?schema=public&sslmode=require"

# AWS S3 Private Bucket & CloudFront Protected Media Storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=YourAwsSecretAccessKeyXXXXXXXXXXXXXXXX
AWS_S3_BUCKET=apexlearn-production-media-ap-south-1
AWS_CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net
AWS_CLOUDFRONT_KEYPAIR_ID=K2XXXXXXXXXXXX
# AWS_CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Razorpay Payment Gateway (Live Credentials)
RAZORPAY_KEY_ID=rzp_live_YourLiveKeyId
RAZORPAY_KEY_SECRET=YourLiveRazorpaySecret
RAZORPAY_WEBHOOK_SECRET=YourConfiguredWebhookSecretKey

# Transactional Email (Amazon SES or SMTP)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIAXXXXXXXXXXXXXXXX
SMTP_PASS=YourSesSmtpGeneratedPassword
SMTP_FROM="ApexLearn Institute <admissions@yourdomain.com>"
